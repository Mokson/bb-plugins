{
  "name": "bb-plugin-skill-usage",
  "version": "0.1.0",
  "type": "module",
  "description": "Skill invocations used in a thread, with project and global rollups, in the thread right panel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mokson/bb-plugins.git",
    "directory": "plugins/skill-usage"
  },
  "homepage": "https://github.com/Mokson/bb-plugins/tree/main/plugins/skill-usage#readme",
  "engines": {
    "bb": ">=0.40.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Skill Usage",
