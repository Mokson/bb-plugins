    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.40.0",
    "better-sqlite3": "^12.10.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
