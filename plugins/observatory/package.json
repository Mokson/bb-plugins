{
  "name": "bb-plugin-observatory",
  "version": "0.0.3",
  "type": "module",
  "description": "Cost, cache, stall, context, audit, eval and distillery for bb agent runs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mokson/bb-plugins.git",
    "directory": "plugins/observatory"
  },
  "homepage": "https://github.com/Mokson/bb-plugins/tree/main/plugins/observatory#readme",
  "engines": {
    "bb": ">=0.40.0",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Observatory",
    "description": "Cost, cache, stall, context, audit, eval and distillery for bb agent runs.",
    "branding": {
      "icon": "Eye"
